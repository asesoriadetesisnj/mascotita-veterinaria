rules_version = '2';
// =====================================================================
// Reglas de Seguridad de Firestore para Mascotita
// ---------------------------------------------------------------------
// Principios:
//  - Solo usuarios autenticados pueden leer/escribir.
//  - ADMIN puede todo.
//  - USER tiene permisos limitados por coleccion.
//  - "auditoria" solo permite create (nunca update/delete).
//  - "config" y "users" solo ADMIN puede modificar.
// Pega estas reglas en Firebase Console -> Firestore -> Reglas.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Funciones auxiliares ----
    function autenticado() {
      return request.auth != null;
    }
    function perfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function esAdmin() {
      return autenticado() && perfil().role == 'admin' && perfil().active == true;
    }
    function esUsuarioActivo() {
      return autenticado() && perfil().active == true;
    }

    // ---- Usuarios: lectura para autenticados, escritura solo ADMIN ----
    match /users/{uid} {
      // El usuario puede leer su propio perfil para iniciar/cargar sesion.
      // Un ADMIN puede leer los perfiles de los demas usuarios.
      // Esto evita la dependencia circular que existia entre read -> esUsuarioActivo() -> perfil().
      allow read: if autenticado()
        && (request.auth.uid == uid || esAdmin());

      // El propio usuario puede actualizar solamente lastLogin; el ADMIN puede modificar cualquier campo.
      allow update: if esAdmin()
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']));

      allow create, delete: if esAdmin();
    }

    // ---- Configuracion: lectura autenticados, escritura solo ADMIN ----
    match /config/{doc} {
      allow read: if esUsuarioActivo();
      allow write: if esAdmin();
    }

    // ---- Auditoria: cualquier autenticado puede CREAR, nadie edita/borra ----
    match /auditoria/{doc} {
      allow read: if esAdmin();
      allow create: if esUsuarioActivo();
      allow update, delete: if false;
    }

    // ---- Facturas y ventas: lectura/escritura solo ADMIN ----
    match /facturas/{doc} {
      allow read, write: if esAdmin();
    }
    match /ventas/{doc} {
      allow read, write: if esAdmin();
    }

    // ---- Productos (stock): lectura todos; crear/editar/borrar solo ADMIN ----
    //  (USER solo puede registrar movimientos, ver mas abajo).
    match /productos/{doc} {
      allow read: if esUsuarioActivo();
      allow create, delete: if esAdmin();
      // USER puede actualizar unicamente la cantidad (por movimientos);
      // ADMIN puede actualizar cualquier campo (incluye precios).
      allow update: if esAdmin()
        || (esUsuarioActivo()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidad']));
    }
    match /movimientos_stock/{doc} {
      allow read: if esUsuarioActivo();
      allow create: if esUsuarioActivo();
      allow update, delete: if esAdmin();
    }

    // ---- Modulos operativos: USER activo puede operar ----
    match /mascotas/{doc}      { allow read, write: if esUsuarioActivo(); }
    match /propietarios/{doc}  { allow read, write: if esUsuarioActivo(); }
    match /consultas/{doc}     { allow read, write: if esUsuarioActivo(); }
    match /cirugias/{doc}      { allow read, write: if esUsuarioActivo(); }
    match /citas/{doc}         { allow read, write: if esUsuarioActivo(); }
    match /plantillas_whatsapp/{doc} {
      allow read: if esUsuarioActivo();
      allow write: if esAdmin();
    }

    // ---- Por defecto: denegar todo lo no contemplado ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
