rules_version = '2';
// =====================================================================
// Reglas de Seguridad de Firebase Storage para Mascotita
// ---------------------------------------------------------------------
// Solo usuarios autenticados pueden subir/leer imagenes de mascotas.
// Se limita el tamano (5 MB) y el tipo a imagenes.
// Pega estas reglas en Firebase Console -> Storage -> Reglas.
// =====================================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /mascotas/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
